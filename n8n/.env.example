# n8n stack — workflow automation and its sandbox cluster.
#
# ./setup.sh copies this to n8n/.env when that file does not exist yet. A stack
# that ships its own .env.example takes precedence over the repo-root one, which
# is why TLD and TZ appear here as well.
#
# n8n/.env is gitignored.

TLD=test
TZ=Pacific/Auckland
PUID=1000
PGID=1000

# --- Sandbox cluster secrets ------------------------------------------------
#
# `change-me` is a placeholder: ./setup.sh replaces each one with a generated
# 32-character value when it creates your .env, so a fresh install never runs
# with published defaults.
#
# SANDBOX_API_KEYS is the key n8n authenticates to the sandbox API with. n8n's
# copy is derived from this same value in compose.yml — do not add a separate
# N8N_SANDBOX_SERVICE_API_KEY here, or the two would be generated independently
# and never match.
SANDBOX_API_KEYS=change-me
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=change-me
SANDBOX_API_RUNNER_API_KEY=change-me

# --- Derived by compose.yml (shown here only so they are easy to find) -------
#
# N8N_SANDBOX_SERVICE_API_KEY = SANDBOX_API_KEYS
# N8N_INSTANCE_AI_SEARXNG_URL = https://searxng.$TLD   (the ../searxng stack)
# N8N_WEBHOOK_URL             = https://n8n.$TLD/
