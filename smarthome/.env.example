# smarthome stack — Home Assistant, its database, MQTT, Zigbee2MQTT, ESPHome,
# VoiceBM.
#
# ./setup.sh copies this to smarthome/.env, and adds any key an older .env is
# missing. smarthome/.env is gitignored.
#
# Compose interpolates this file, so avoid a bare "$" or quote the value.

# TLD is only ever set in the root .env.example: @TLD@ is expanded from it.
TLD=@TLD@
TZ=Pacific/Auckland
PUID=1000
PGID=1000

# This host's LAN address, for VoiceBM's URLs (its dashboard and the audio it
# serves to cameras and speakers). Filled in by ./setup.sh.
HOST_IP=@HOST_IP@

# Home Assistant's history database. The password is only read when the
# database is first created.
HA_DB_PASSWORD=change-me
HA_DB_ROOT_PASSWORD=change-me
# Published on 127.0.0.1 only. Change it if something else on this host
# already listens on 3306.
HA_DB_PORT=3306

# The MQTT login everything here uses (HA, Zigbee2MQTT, VoiceBM, your
# devices). Mosquitto takes it from here at every start.
MQTT_USER=mqtt
MQTT_PASSWORD=change-me

# Zigbee: the coordinator's /dev/serial/by-id/... path. ./setup.sh fills both
# in when it finds a dongle; with them empty, Zigbee2MQTT does not start.
ZIGBEE_DEVICE=
COMPOSE_PROFILES=

# --- VoiceBM (defaults shown) -------------------------------------------------
# Speaker recognition model (downloaded on first start): nemo_en_titanet_small
# (38 MB), nemo_en_titanet_large (97 MB, most accurate), wespeaker_en_voxceleb_
# CAM++_LM (28 MB), ... — see build/voicebm/entrypoint.sh.
#VOICEBM_SPEAKER_MODEL=nemo_en_titanet_small.onnx
# Speech-to-text (RAM once loaded / latency on a 6.6 s clip, i5-8500, 4 threads):
# parakeet-tdt-0.6b-v3 (0.8 GB / 0.46 s, 25 European languages, auto-detected),
# parakeet-unified-en-0.6b (0.8 GB / 0.48 s, English), parakeet-tdt-0.6b-v2
# (0.8 GB / 0.46 s, English), cohere-transcribe (2.0 GB / 1.9 s, 14 languages,
# most accurate), parakeet-tdt-110m (0.2 GB / 0.19 s, English),
# nemo-parakeet-ctc-110m (0.2 GB / 0.13 s, fastest, no punctuation),
# sensevoice-small (0.3 GB / 0.18 s), whisper-small (0.5 GB / 2.8 s).
#VOICEBM_STT_MODEL=parakeet-tdt-0.6b-v3
#VOICEBM_STT_LANGUAGE=en
#VOICEBM_STT_THREADS=4
