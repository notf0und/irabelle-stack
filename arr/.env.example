# arr stack — Sonarr, Radarr, Prowlarr, Bazarr, Lingarr, Cleanuparr, Byparr and
# Transmission.
#
# ./setup.sh copies this to arr/.env when that file does not exist yet, and adds
# any key below that an older arr/.env is missing. arr/.env is gitignored.
#
# Compose interpolates this file, so avoid a bare "$" or quote the value.

# TLD is only ever set in the root .env.example: @TLD@ is expanded from it.
TLD=@TLD@
TZ=Pacific/Auckland
PUID=1000
PGID=1000

# API keys. Generated by ./setup.sh (every `change-me` below) and handed to the
# apps through their environment, so they are fixed from the first start and
# setup.sh can wire the apps together without reading them back out of each
# app's config.xml. Changing one later breaks every integration that uses it —
# re-run ./setup.sh afterwards so it updates the others.
SONARR_API_KEY=change-me
RADARR_API_KEY=change-me
PROWLARR_API_KEY=change-me

# Lingarr's MariaDB. Only read when the database is first created.
LINGARR_DB_PASSWORD=change-me
LINGARR_DB_ROOT_PASSWORD=change-me
