# ---------------------------------------------------------------------------
# irabelle-stack host settings: networking for ./host-vlan.sh (needs sudo),
# and the choices ./setup.sh asks about and remembers (FAST_DATA_DIR and
# DSH_INSTALL, at the end).
#
#   cp host.env.example host.env
#
# Kept separate from .env on purpose: .env is copied into every stack and
# handed to containers through env_file, and host interface names have no
# business inside a container.
#
# host.env is gitignored. Every value here has the same default built into the
# script, so this file only needs the values you actually want to change.
# ---------------------------------------------------------------------------

# 802.1Q id of the router's Docker.Online VLAN. The subnet, host address and
# gateway default to 192.168.<id>.0/24, .2 and .1, so this one value moves the
# whole scheme — as long as the router's VLAN follows the same convention.
DOCKER_VLAN_ID=40

# Interface name created on the host. station calls its VLAN interface
# `Docker.VLAN`; the router calls this zone's device `Docker.Online`.
DOCKER_VLAN_NAME=Docker.Online

# Host NIC that carries the VLAN. Leave unset to use whichever NIC currently
# holds the default route (on carlos that is enp1s0, the single cable to the
# client router).
#HOST_NIC=enp1s0

# Static addressing on the VLAN. The router is .1 and its DHCP pool is
# .100-.249, so .2 is comfortably outside it.
DOCKER_VLAN_ADDRESS=192.168.40.2/24
DOCKER_VLAN_GATEWAY=192.168.40.1

# Docker network created on top of the VLAN interface. Containers that need a
# real address on the VLAN (Pi-hole, Unbound) attach to this.
DOCKER_MACVLAN_NETWORK=app-macvlan

# 0 (default) = fail-closed. The LAN still gives this host its address, but no
#     default route, so container egress can only ever leave through the Docker
#     VLAN. If the trunk is wrong the host has no internet at all — loud, and
#     never a silent leak into the lan zone.
# 1 = fail-open. Keep the LAN default route as a fallback (metric 100 against
#     the VLAN's 50) so the host survives a misconfigured trunk, at the cost of
#     container traffic falling back into the lan zone when that happens.
KEEP_LAN_DEFAULT_ROUTE=0

# Where every stack's config/ (its settings and databases) lives, when this
# checkout is on a slow disk: a directory on an SSD, bind-mounted back at the
# same paths by ./fast-disk.sh. ./setup.sh asks on its first run and writes it
# here; "none" keeps them in the checkout and stops it asking. Unset = ask.
#FAST_DATA_DIR=/home/irabelle-stack-data

# Install the DeepSeek Harness at dsh.$TLD (see dsh/README.md). It is a host
# systemd *user* service rather than a container, so it needs Node.js on this
# host — which is why ./setup.sh asks instead of assuming. "yes" installs it
# and keeps it refreshed on later runs; "no" never does. Unset = ask, except
# that an install which already exists is refreshed without asking.
#DSH_INSTALL=yes

# Set up authentik as the forward-auth login in front of every web UI. "no"
# skips the authentik stack entirely and publishes every service at
# <name>.$TLD without a login (the app's own, where it still has one), by
# writing AUTH_MIDDLEWARE=no-auth@docker into the stacks' .env. ./setup.sh asks
# on its first run (default yes) and writes the answer here; --authentik /
# --no-authentik answer without being asked. See README.md's
# "Single sign-on (authentik)" section.
#AUTHENTIK_INSTALL=yes
