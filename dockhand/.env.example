# dockhand stack — the Docker management UI.
#
# ./setup.sh copies this to dockhand/.env and expands @REPO_DIR@ to this
# checkout's absolute path on the host. dockhand/.env is gitignored.

# Absolute path to this checkout, as seen on the host.
#
# It must be absolute and it must be the same inside the container, because
# Dockhand runs `docker compose` for stacks that use relative bind mounts
# (./config/foo). Compose resolves those against the stack directory *inside*
# the container, and the host daemon then has to find that exact path. Get it
# wrong and Docker quietly creates empty directories instead — a missing file
# mount becomes a directory, which is how a stack "deploys" while silently
# reading nothing.
#
# setup.sh writes this for you; only edit it if the checkout moves.
STACK_ROOT=@REPO_DIR@

# TLD is only ever set in the root .env.example: @TLD@ is expanded from it at
# copy time. Rename the domain by editing the root .env and re-running
# ./setup.sh, never this file.
TLD=@TLD@
TZ=Pacific/Auckland

# uid/gid the containers run as. dockhand reads and writes
# dockhand/config/dockhand, so these should match the owner of this checkout.
PUID=1000
PGID=1000

# Optional. Serves Dockhand's own OpenAPI spec at /api/docs and an interactive
# viewer at /api/docs/ui — useful for scripting against the API (see
# update.sh). Both routes are UNAUTHENTICATED even when Dockhand login
# is enabled, which is why they are off by default. Turn this on only while you
# need it.
#FEAT_API_DOCS=true
