# mail stack — Mailpit.
#
# ./setup.sh copies this to mail/.env. mail/.env is gitignored.

TLD=@TLD@
TZ=Pacific/Auckland
PUID=1000
PGID=1000

# --- optional: pass mail on ------------------------------------------------
# Call a webhook for every message (e.g. a Home Assistant automation:
# http://homeassistant.<TLD>/api/webhook/<id>).
#MP_WEBHOOK_URL=
# Relay to a real mail server: its settings go in config/mailpit/relay.yaml
# (see https://mailpit.axllent.org/docs/configuration/smtp-relay/), and
# MP_SMTP_RELAY_MATCHING picks which recipients are relayed automatically.
#MP_SMTP_RELAY_CONFIG=/data/relay.yaml
#MP_SMTP_RELAY_MATCHING=you@example\.com
