# pocket-tts2 stack — the Pocket TTS 2.1.0 voice server.
#
# ./setup.sh copies this to pocket-tts2/.env when that file does not exist yet. A
# stack that ships its own .env.example takes precedence over the repo-root one,
# which is why TZ appears here as well.
#
# pocket-tts2/.env is gitignored.

# This stack is not published through Traefik (see compose.yml), so TLD is not
# used — it is here because every stack's .env carries it, and ./setup.sh warns
# when one disagrees with the repo root.
TLD=test
TZ=Pacific/Auckland
PUID=1000
PGID=1000

# Optional. A Hugging Face token lifts the anonymous rate limit while the models
# are downloaded on first run. Leave empty to download anonymously.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=
