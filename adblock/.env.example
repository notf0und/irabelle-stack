# adblock stack — Pi-hole plus a local recursive Unbound.
#
# ./setup.sh copies this to adblock/.env when that file does not exist yet. A
# stack that ships its own .env.example takes precedence over the repo-root
# one, which is why TLD and TZ appear here as well.
#
# adblock/.env is gitignored.

TLD=test
TZ=Pacific/Auckland

# Password for the Pi-hole admin UI and API (https://pihole.$TLD/admin).
# Compose interpolates this file, so avoid a bare "$" or quote the value.
PIHOLE_PASSWORD=change-me

# Static addresses on the router's Docker.Online VLAN (192.168.40.0/24).
# The router is .1 and its DHCP pool is .100-.249, so these are well clear.
PIHOLE_IP=192.168.40.5
UNBOUND_IP=192.168.40.6
