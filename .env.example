# Values copied into .env at the repo root and into every stack that does not
# have its own .env.example (see ./setup.sh). Everything here reaches the
# containers, so keep host-level settings out — those live in host.env.example,
# which ./setup.sh and ./host-vlan.sh read.
TLD=smart
TZ=Pacific/Auckland
PUID=1000
PGID=1000

# The middleware every web router names. ./setup.sh writes this into each
# stack's .env from the authentik answer: authentik@docker normally, or
# no-auth@docker when authentik is opted out of (see host.env.example). The
# compose label falls back to authentik@docker when the key is absent, so a
# git-based deploy that has no .env behaves as before.
#AUTH_MIDDLEWARE=authentik@docker
