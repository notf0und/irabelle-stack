# authentik stack — single sign-on for Dockhand and Pi-hole.
#
# ./setup.sh copies this to authentik/.env when that file does not exist yet,
# asks for ADMIN_USERNAME, and replaces every `change-me` below with a
# generated value. authentik/.env is gitignored.
#
# Compose interpolates this file, so avoid a bare "$" or quote the value.

# TLD is only ever set in the root .env.example: @TLD@ is expanded from it at
# copy time. The blueprint builds every URL from it (authentik.$TLD,
# dockhand.$TLD, pihole.$TLD).
TLD=@TLD@
TZ=Pacific/Auckland

# uid/gid every container here runs as — postgres included — so the database
# and media under authentik/config stay yours. Match the checkout's owner.
PUID=1000
PGID=1000

# --- your login --------------------------------------------------------------
# The one account for authentik, Dockhand and Pi-hole. Created once, the first
# time the worker applies the blueprint: change the password afterwards in
# authentik (top right -> Settings), not here — editing it here does nothing
# once the user exists.
#
# ./setup.sh also creates a *local* Dockhand user with the same name and
# password, so Dockhand stays reachable if authentik is ever down. That copy
# does not follow later password changes in authentik.
ADMIN_USERNAME=
ADMIN_PASSWORD=change-me
# Optional.
ADMIN_EMAIL=

# --- secrets -----------------------------------------------------------------
# Generated by ./setup.sh. AUTHENTIK_SECRET_KEY signs sessions and cookies:
# changing it logs everybody out. POSTGRES_PASSWORD is only read when the
# database is first created, so changing it later locks authentik out of it.
AUTHENTIK_SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# authentik's own built-in admin, `akadmin`. Not the account you use (that is
# ADMIN_USERNAME above), but it always exists, and without a password its
# first-run setup page would let anyone on the LAN claim it. Only read on the
# very first start.
AUTHENTIK_BOOTSTRAP_PASSWORD=change-me

# Shared between the Dockhand client in the blueprint and the provider
# ./setup.sh registers in Dockhand. Change it in both places or neither.
DOCKHAND_OIDC_CLIENT_SECRET=change-me

AUTHENTIK_ERROR_REPORTING__ENABLED=false
