# books stack — Calibre, Calibre-Web-Automated, the Shelfmark downloader, Kavita
# and the books-glue sync service.
#
# ./setup.sh copies this to books/.env when that file does not exist yet. A stack
# that ships its own .env.example takes precedence over the repo-root one, which
# is why TLD, TZ and PUID/PGID appear here as well.
#
# books/.env is gitignored.

# TLD is only ever set in the root .env.example: @TLD@ is expanded from it.
TLD=@TLD@
TZ=Pacific/Auckland
PUID=1000
PGID=1000

# Kavita API key used by books-glue to trigger a library scan when a new book
# lands. ./setup.sh fills it in once it has created your Kavita account (the
# key is Kavita's to issue, so it cannot be generated up front). Empty
# disables the scan; the glue then only fixes downloader links.
KAVITA_API_KEY=

# --- books-glue toggles (uncomment to change; all default to ON except the
#     Calibre restart) -------------------------------------------------------
# Master switch: false makes the glue idle without removing the service.
#GLUE_ENABLED=false
# Stop rewriting the downloader's history after CWA moves a file.
#GLUE_FIX_DOWNLOADER=false
# Stop triggering Kavita scans on new books.
#GLUE_SCAN_KAVITA=false
# Also restart the Calibre GUI container when a new book lands (it holds the
# library in memory and cannot see CWA's imports until it is restarted). This
# briefly disconnects the calibre.$TLD tab, so it is off by default.
#CALIBRE_AUTO_RESTART=true

# --- books-glue: daily shadow-library mirror refresh (all default to ON) ------
#MIRROR_REFRESH_ENABLED=false
# Seconds between refreshes.
#MIRROR_REFRESH_INTERVAL=86400
#MIRROR_REFRESH_SOURCES=aa,libgen,zlib,welib
# Also accept mirrors open-slum.org marks as degraded (one failed check).
#MIRROR_REFRESH_INCLUDE_DEGRADED=true

# --- Shelfmark ------------------------------------------------------------------
# Skip the automated DDoS-Guard bypass and always ask you (tests the manual path).
#MANUAL_SOLVE_ONLY=true
# Anna's Archive search cache: on/off, lifetime in seconds, entries kept.
#AA_SEARCH_CACHE=false
#AA_SEARCH_CACHE_TTL=21600
#AA_SEARCH_CACHE_MAX=100
