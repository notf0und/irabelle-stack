# searxng stack — the meta-search engine plus Valkey.
#
# ./setup.sh copies this to searxng/.env when that file does not exist yet. A
# stack that ships its own .env.example takes precedence over the repo-root one,
# which is why TLD and TZ appear here as well.
#
# searxng/.env is gitignored.

TLD=test
TZ=Pacific/Auckland

# Secret used to sign SearXNG's session cookies and CSRF tokens.
#
# The literal value `change-me` is a placeholder: ./setup.sh replaces it with a
# generated 32-character value when it creates your .env, so a fresh install
# never runs with a published default. Read the real one from this file.
#
# Compose interpolates this file, so avoid a bare "$" or quote the value.
SEARXNG_SECRET=change-me
