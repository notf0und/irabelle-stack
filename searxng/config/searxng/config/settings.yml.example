# SearXNG settings — per-install config.
#
# ./setup.sh copies this to config/searxng/config/settings.yml when that file
# does not exist yet, and never overwrites it afterwards. The copy is gitignored,
# so editing it can never block a `git pull`.
#
# `use_default_settings: true` means the image's full default settings are merged
# underneath these few overrides, so this file stays short on purpose.
#
# The secret key is deliberately NOT here: it lives in `SEARXNG_SECRET` in
# ../.env (generated by ./setup.sh), so it never reaches git.

use_default_settings: true

search:
  formats:
    - html
    - json

server:
  # SearXNG serves absolute URLs; the image reads SEARXNG_BASE_URL from the
  # environment, which compose.yml derives from TLD. Nothing to set here.
  image_proxy: true
  # Optional: SearXNG's rate limiter can use the Valkey service in this stack.
  # Uncomment both this and the `redis.url` below to turn it on; the service
  # already runs either way.
  #limiter: true

#redis:
#  url: redis://searxng-redis:6379/0
